node_modules/
dist/
release/
backend-dist/
backend-build/
*.log
.env

# Step 6 — Mixamo .fbx clips are user-supplied. Adobe TOS allows personal
# use but redistribution is grey, so keep user-side .fbx out of git.
# manifest.json + README.md inside the folder are tracked (they describe
# the contract); only the binaries are excluded.
src/assets/motions/fbx/**/*.fbx
src/assets/motions/fbx/**/*.FBX

# /goal Step 5 — .vmd idle pack from Deedee524 (DeviantArt) ships under
# "use freely, credit me, do NOT redistribute original motions". The
# LICENSE-<author>.txt files inside the folder are tracked (they carry
# the author's permission statement); the .vmd binaries are not.
src/assets/motions/vmd/**/*.vmd
src/assets/motions/vmd/**/*.VMD
# …but Apia-generated original clips (scripts/gen-vmd.py) carry no license
# restriction and are model-agnostic (gesture deltas; the per-model arm hang is
# composed at runtime), so ship them. Whitelist each generated file.
!src/assets/motions/vmd/talk/explain.vmd
!src/assets/motions/vmd/talk/think.vmd
